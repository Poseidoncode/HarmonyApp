<Application x:Class="HarmonyPrompts.Windows.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <Style TargetType="Window">
   <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
   <Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="14" />
   <Setter Property="UseLayoutRounding" Value="True" />
  </Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,7" /><Setter Property="Margin" Value="0,0,8,6" />
   <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="8,6" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6" /><Setter Property="MinHeight" Value="34" /></Style>
 </Application.Resources>
</Application>
